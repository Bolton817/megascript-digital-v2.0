# -----------------------------------------------------------------------------
# MegaScript Digital - Environment Configuration Template (.env.example)
# Authoritative Reference: TDD Specification Sheet 129 & Appendix 08
# Note: Never commit actual secret keys or sensitive tokens to version control.
# -----------------------------------------------------------------------------

# Application Environment & URLs
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database Connections (Supabase PostgreSQL)
# DATABASE_URL uses the Supavisor transaction pooler (port 6543) for serverless execution.
# DIRECT_URL uses the direct database connection (port 5432) for Prisma migrations.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication (Better Auth & Email OTP)
# Generate a secure 32+ character random string for BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_ALLOWED_EMAILS="megascriptdigital@gmail.com,boltonmoseti78@gmail.com"
SUPER_ADMIN_EMAIL="megascriptdigital@gmail.com"

# Transactional Email & Marketing (Brevo)
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="info@megascriptdigital.co.ke"
BREVO_SENDER_NAME="MegaScript Digital"
BREVO_WEBHOOK_SECRET="your-brevo-webhook-signing-secret"

# AI Assistant (Tony - Gemini & DeepSeek)
# Provider keys must be stored server-side only. Plaintext exposure is strictly prohibited.
GEMINI_API_KEY="your-gemini-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
# 256-bit (32-byte) hex string for authenticated encryption of credentials stored in database
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional External Analytics & Platform Integrations (Connected progressively)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""

# Supabase Storage (Object Store for Media Uploads)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
